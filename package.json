{
	"name": "sveltekit-cloudflare-demo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node scripts/test.js",
		"update-kit": "node scripts/update.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "cf workers types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "cf workers types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@cloudflare/config": "0.31.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-cloudflare": "https://pkg.svelte.dev/@sveltejs/adapter-cloudflare/c/0ea84b909760c0cbb53e5cc3d043ee6ad6123e60",
		"@sveltejs/kit": "https://pkg.svelte.dev/@sveltejs/kit/c/0ea84b909760c0cbb53e5cc3d043ee6ad6123e60",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"cf": "1.0.0-beta.28",
		"demo-styled-lib": "file:./vendor/styled-lib",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"vite": "^8.3.0"
	}
}
